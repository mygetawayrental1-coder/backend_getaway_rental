{
  "name": "mygateway-rental-backend",
  "version": "1.0.0",
  "description": "Backend API for MyGatewayRental - Property rental platform",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "postinstall": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "db:seed": "node prisma/seed.js",
    "test": "jest --runInBand --forceExit",
    "test:unit": "jest tests/unit --runInBand --forceExit",
    "test:integration": "jest tests/integration --runInBand --forceExit",
    "test:watch": "jest --watch"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@clerk/backend": "^3.4.7",
    "@clerk/express": "^2.1.15",
    "@paypal/paypal-server-sdk": "^2.1.0",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.5.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.2",
    "express-validator": "^7.3.1",
    "file-type": "^22.0.1",
    "ical-generator": "^10.0.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "node-ical": "^0.25.4",
    "nodemailer": "^7.0.12",
    "prisma": "^5.22.0",
    "resend": "^6.9.3",
    "sharp": "^0.35.3",
    "sib-api-v3-sdk": "^8.5.0",
    "svix": "^1.93.0",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "nodemon": "^3.1.11",
    "supertest": "^7.2.2"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "testTimeout": 30000,
    "verbose": true,
    "transformIgnorePatterns": [
      "node_modules/(?!(uuid|file-type|strtok3|token-types|peek-readable)/)"
    ],
    "moduleNameMapper": {
      "file-type": "<rootDir>/tests/__mocks__/file-type.js",
      "^uuid$": "<rootDir>/tests/__mocks__/uuid.js",
      "^sharp$": "<rootDir>/tests/__mocks__/sharp.js"
    },
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/config/database.js"
    ]
  }
}
