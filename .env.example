PORT=5000
NODE_ENV=development
APP_URL=http://localhost:5000
# Comma-separated list of allowed frontend origins (no trailing slash)
FRONTEND_URL=http://localhost:3000,http://localhost:5173
# Must match website REVALIDATE_SECRET (no hardcoded fallback in code)
REVALIDATE_SECRET=

# PayPal (owner subscription payments) — keep secret server-side only
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Public website origin for PayPal return/cancel (no trailing slash)
WEBSITE_URL=https://mygetawayrental.com
# Optional: PayPal webhook URL on this API: POST /webhooks/paypal

DATABASE_URL="postgresql://USER:PASSWORD@HOST/railway?sslmode=require"

CLERK_SECRET_KEY=sk_test_xxxx
CLERK_PUBLISHABLE_KEY=pk_test_xxxx

BREVO_API_KEY=xkeysib-xxxx
BREVO_FROM_EMAIL=noreply@yourdomain.com
BREVO_FROM_NAME=MyGetawayRental

# optional SMTP fallback (often blocked on Render)
# BREVO_SMTP_USER=your-login@smtp-brevo.com
# BREVO_SMTP_PASS=xsmtpsib-your-smtp-key
# BREVO_SMTP_HOST=smtp-relay.brevo.com
# BREVO_SMTP_PORT=587

UPLOAD_DIR=./uploads
# Railway: mount a volume and set UPLOAD_DIR to that exact mount path
# (this project uses Mount Path=/uploads → UPLOAD_DIR=/uploads)

# optional
# CLERK_WEBHOOK_SECRET=whsec_xxxx
# ADMIN_EMAIL=you@example.com
# SITE_NAME=MyGetawayRental
# SUBSCRIPTION_REQUIRE_PAYMENT=true
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
