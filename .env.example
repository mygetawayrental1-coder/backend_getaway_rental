# ====================
# Server Configuration
# ====================
PORT=5000
NODE_ENV=development
APP_URL=http://localhost:5000

# ====================
# Database (Neon PostgreSQL recommended)
# ====================
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Local Docker (optional): docker compose up -d in backend/
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mygateway_rental"
#
# Apply migrations: npx prisma migrate deploy
# (with DATABASE_URL set to the local URL above)

# ====================
# JWT Authentication
# ====================
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# ====================
# Clerk (Next.js / Flutter — hybrid auth with legacy JWT)
# ====================
# CLERK_SECRET_KEY=sk_live_xxxx
# CLERK_PUBLISHABLE_KEY=pk_live_xxxx
# CLERK_WEBHOOK_SECRET=whsec_xxxx

# Subscriptions: set to true when PayPal/Razorpay activation is required (default: activate on subscribe)
# SUBSCRIPTION_REQUIRE_PAYMENT=true

# ====================
# Brevo SMTP (Settings → SMTP & API in app.brevo.com)
# ====================
BREVO_SMTP_USER=your-login@smtp-brevo.com
BREVO_SMTP_PASS=xsmtpsib-your-smtp-key
BREVO_FROM_EMAIL=noreply@yourdomain.com
BREVO_FROM_NAME=MyGetawayRental
# BREVO_SMTP_HOST=smtp-relay.brevo.com
# BREVO_SMTP_PORT=587

# ====================
# File Uploads
# ====================
UPLOAD_DIR=./uploads

# ====================
# Frontend URL (for password reset emails)
# ====================
FRONTEND_URL=http://localhost:5173

# ====================
# PayPal (Optional — payment features disabled if not set)
# ====================
# PAYPAL_CLIENT_ID=your-paypal-client-id
# PAYPAL_CLIENT_SECRET=your-paypal-client-secret

# ====================
# Razorpay (Optional — payment features disabled if not set)
# ====================
# RAZORPAY_KEY_ID=your-razorpay-key-id
# RAZORPAY_KEY_SECRET=your-razorpay-key-secret
