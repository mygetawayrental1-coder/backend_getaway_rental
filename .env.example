# ====================
# Server Configuration
# ====================
PORT=5000
NODE_ENV=development
APP_URL=http://localhost:5000

# ====================
# Database
# ====================
DATABASE_URL="postgresql://user:password@localhost:5432/mygateway_rental"

# Local Docker (from backend/): docker compose up -d
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mygateway_rental"
#
# Apply migrations: npx prisma migrate deploy
# (with DATABASE_URL set to the local URL above)

# ====================
# JWT Authentication
# ====================
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# ====================
# Clerk (Next.js / Flutter — hybrid auth with legacy JWT)
# ====================
# CLERK_SECRET_KEY=sk_live_xxxx
# CLERK_PUBLISHABLE_KEY=pk_live_xxxx
# CLERK_WEBHOOK_SECRET=whsec_xxxx

# ====================
# SMTP Email Service
# ====================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
FROM_EMAIL=noreply@mygateway.com

# ====================
# File Uploads
# ====================
UPLOAD_DIR=./uploads

# ====================
# Frontend URL (for password reset emails)
# ====================
FRONTEND_URL=http://localhost:5173

# ====================
# PayPal (Optional — payment features disabled if not set)
# ====================
# PAYPAL_CLIENT_ID=your-paypal-client-id
# PAYPAL_CLIENT_SECRET=your-paypal-client-secret

# ====================
# Razorpay (Optional — payment features disabled if not set)
# ====================
# RAZORPAY_KEY_ID=your-razorpay-key-id
# RAZORPAY_KEY_SECRET=your-razorpay-key-secret
