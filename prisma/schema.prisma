// Owner earnings tracking & payout requests
// =============================================================

model Payout {
  id      String @id @default(cuid())
  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  amount   Float
  currency String @default("USD")

  status    String  @default("PENDING") // PENDING | PROCESSING | PAID | FAILED
  method    String? // "paypal" | "bank_transfer" | "razorpay"
  reference String? // external payout reference ID
  period    String? // "2025-01" — for monthly grouping on earnings dashboard

  notes       String?
  requestedAt DateTime  @default(now())
  processedAt DateTime?
  paidAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
  @@index([status])
  @@index([period])
}

