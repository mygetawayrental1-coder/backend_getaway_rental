// ██████╗  ██████╗  ██████╗ ██╗  ██╗██╗███╗   ██╗ ██████╗ ███████╗
// ██╔══██╗██╔═══██╗██╔═══██╗██║ ██╔╝██║████╗  ██║██╔════╝ ██╔════╝
// ██████╔╝██║   ██║██║   ██║█████╔╝ ██║██╔██╗ ██║██║  ███╗███████╗
// ██╔══██╗██║   ██║██║   ██║██╔═██╗ ██║██║╚██╗██║██║   ██║╚════██║
// ██████╔╝╚██████╔╝╚██████╔╝██║  ██╗██║██║ ╚████║╚██████╔╝███████║
// ╚═════╝  ╚═════╝  ╚═════╝ ╚═╝  ╚═╝╚═╝╚═╝  ╚═══╝ ╚═════╝ ╚══════╝
//
// FULL LIFECYCLE: Pending → Confirmed → Ongoing → Completed
//                                              ↘ Cancelled
// =============================================================

// GuestRequest: unauthenticated contact form (website & mobile)
// → owner sees these in their dashboard, can convert to Inquiry
model GuestRequest {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  fullName String
  email    String
  phone    String?
  message  String?

  checkin  DateTime?
  checkout DateTime?
  guests   Int       @default(1)

  status String @default("NEW") // NEW | VIEWED | CONTACTED | ACCEPTED | REJECTED | CLOSED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([propertyId])
  @@index([status])
  @@index([email])
}

// Inquiry: owner-facing booking pipeline (used in admin portal & owner dashboard)
// Created from GuestRequest or directly
model Inquiry {
  id        String   @id @default(cuid())
  enquiryId String   @unique @default(cuid())

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  // Property snapshot at time of inquiry
  propertyName   String?
  propertyImages String? // JSON

  // Guest details
  fullName String
  email    String
  phone    String?
  gender   String?
  guests   Int     @default(1)
  message  String?

  // Dates
  checkin  DateTime?
  checkout DateTime?
  nights   Int?

  // Pricing
  nightlyRate Float?
  totalAmount Float?

  // Status
  status     String  @default("PENDING") // PENDING | ACCEPTED | REJECTED | BOOKED | CANCELLED
  adminNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([propertyId])
  @@index([userId])
  @@index([status])
  @@index([email])
}

// Booking: confirmed reservation with full lifecycle
// Owner Module lifecycle: Pending → Confirmed → Ongoing → Completed | Cancelled
model Booking {
  id        String   @id @default(cuid())
  bookingId String   @unique @default(cuid())

  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  // Guest info (no auth required for booking)
  guestName    String
  guestEmail   String
  guestPhone   String?
  guestClerkId String? // set if the guest is signed in via Clerk

  // Dates & capacity
  checkin  DateTime
  checkout DateTime
  guests   Int      @default(1)
  nights   Int

  // Pricing snapshot at time of booking
  nightlyRate Int
  weekendRate Int?
  totalAmount Float

  // Status (Owner Module lifecycle)
  status       String  @default("PENDING")  // PENDING | CONFIRMED | ONGOING | COMPLETED | CANCELLED
  cancelledBy  String? // "guest" | "owner" | "admin"
  cancelReason String?

  // Notes
  notes      String? // guest note
  ownerNotes String? // owner private notes

  // Lifecycle timestamps
  confirmedAt DateTime?
  checkedInAt DateTime? // owner marks as Ongoing
  completedAt DateTime?
  cancelledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  payments BookingPayment[]

  @@index([propertyId])
  @@index([checkin, checkout])
  @@index([status])
  @@index([guestEmail])
  @@index([guestClerkId])
}

// Separate payment record for bookings
model BookingPayment {
  id        String  @id @default(cuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  amount        Float
  currency      String  @default("USD")
  status        String  @default("PENDING") // PENDING | PAID | REFUNDED | FAILED
  paymentMethod String? // "paypal" | "card" | "razorpay"
  transactionId String? // external payment gateway reference
  gatewayData   String? // JSON: raw gateway response

  paidAt      DateTime?
  refundedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// =============================================================
// ██████╗ ███████╗██╗   ██╗██╗███████╗██╗    ██╗███████╗
// ██╔══██╗██╔════╝██║   ██║██║██╔════╝██║    ██║██╔════╝
// ██████╔╝█████╗  ██║   ██║██║█████╗  ██║ █╗ ██║███████╗
