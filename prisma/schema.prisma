// ██║  ██║███████╗ ╚████╔╝ ██║███████╗╚███╔███╔╝███████║
// ╚═╝  ╚═╝╚══════╝  ╚═══╝  ╚═╝╚══════╝ ╚══╝╚══╝ ╚══════╝
// 5 rating dimensions · owner reply · admin moderation
// =============================================================

model Review {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  // Author (null if anonymous)
  authorId    String?
  author      User?   @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorName  String
  authorEmail String

  // 5-dimension ratings (1–5)
  sleepRating     Int
  locationRating  Int
  serviceRating   Int
  clearnessRating Int
  roomsRating     Int
  overallRating   Float // auto-calculated average of above 5

  text String @db.Text

  // Moderation
  isApproved Boolean @default(false)

  // Owner reply
  ownerReply     String?  @db.Text
  ownerRepliedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([propertyId])
  @@index([isApproved])
  @@index([authorId])
}

// =============================================================
// ███████╗██╗   ██╗██████╗ ███████╗ ██████╗██████╗ ██╗██████╗ ████████╗██╗ ██████╗ ███╗   ██╗███████╗
// ██╔════╝██║   ██║██╔══██╗██╔════╝██╔════╝██╔══██╗██║██╔══██╗╚══██╔══╝██║██╔═══██╗████╗  ██║██╔════╝
// ███████╗██║   ██║██████╔╝███████╗██║     ██████╔╝██║██████╔╝   ██║   ██║██║   ██║██╔██╗ ██║███████╗
// ╚════██║██║   ██║██╔══██╗╚════██║██║     ██╔══██╗██║██╔═══╝    ██║   ██║██║   ██║██║╚██╗██║╚════██║
// ███████║╚██████╔╝██████╔╝███████║╚██████╗██║  ██║██║██║        ██║   ██║╚██████╔╝██║ ╚████║███████║
// ╚══════╝ ╚═════╝ ╚═════╝ ╚══════╝ ╚═════╝╚═╝  ╚═╝╚═╝╚═╝        ╚═╝   ╚═╝ ╚═════╝ ╚═╝  ╚═══╝╚══════╝
// Owners buy a plan → can list properties
// =============================================================

model SubscriptionPlan {
  id            String  @id @default(cuid())
  name          String
  price         Float
  specialPrice  Float?
  duration      String  // Monthly | Yearly
  maxProperties Int     @default(1) // how many listings this plan allows
  features      String? // JSON: ["Feature 1", "Feature 2", ...]
  status        String  @default("Active") // Active | Inactive

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions UserSubscription[]
  coupons       Coupon[]

  @@index([status])
}

model UserSubscription {
  id        String   @id @default(cuid())
  startDate DateTime @default(now())
  endDate   DateTime
  status    String   @default("ACTIVE") // PENDING | ACTIVE | EXPIRED | CANCELLED
  autoRenew Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId   String
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  planId   String
  plan     SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  couponId String?
  coupon   Coupon?          @relation(fields: [couponId], references: [id], onDelete: SetNull)
  payment  Payment?

  @@index([userId])
  @@index([status])
}

// Discount/promo codes for subscriptions
model Coupon {
  id            String    @id @default(cuid())
  code          String    @unique
  discountType  String    // PERCENT | FIXED
  discountValue Float
  maxUses       Int?
  usedCount     Int       @default(0)
  expiresAt     DateTime?
  isActive      Boolean   @default(true)

  // Optional: restrict to a specific plan
  planId String?
  plan   SubscriptionPlan? @relation(fields: [planId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  subscriptions UserSubscription[]

  @@index([code])
  @@index([isActive])
}

// =============================================================
// ██████╗  █████╗ ██╗   ██╗███╗   ███╗███████╗███╗   ██╗████████╗███████╗
