// =============================================================
// MyGetawayRental — Unified Prisma Schema v2.0
// =============================================================
// Supports:
//   • Next.js 14 Website      (Clerk session JWT)
//   • Flutter App iOS/Android (Clerk Flutter SDK)
//   • React Admin Portal      (Clerk React SDK)
//   • Node/Express Backend    (@clerk/express + @clerk/backend)
//
// Auth: Full Clerk — NO legacy JWT, NO passwords stored
// DB:   PostgreSQL (Render)
// ORM:  Prisma 5
// =============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================
// ██╗   ██╗███████╗███████╗██████╗ ███████╗
// ██║   ██║██╔════╝██╔════╝██╔══██╗██╔════╝
// ██║   ██║███████╗█████╗  ██████╔╝███████╗
// ██║   ██║╚════██║██╔══╝  ██╔══██╗╚════██║
// ╚██████╔╝███████║███████╗██║  ██║███████║
//  ╚═════╝ ╚══════╝╚══════╝╚═╝  ╚═╝╚══════╝
// All authentication handled by Clerk.
// clerkId = primary identifier. No passwords stored here.
// Clerk Webhook (user.created / user.updated) → upsert this model.
// =============================================================

model User {
  id          String  @id @default(cuid())
  clerkId     String  @unique // Clerk user ID — required, all auth via Clerk
  email       String  @unique
  firstName   String
  lastName    String
  countryCode String?
  phoneNumber String?
  address     String?
  profilePic  String?
  role        String  @default("END_USER") // ADMIN | OWNER | END_USER
  about               String?
  paymentInstructions String? @db.Text
  isActive            Boolean @default(true) // admin can suspend

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  ownedProperties  Property[]
  inquiries        Inquiry[]
  subscriptions    UserSubscription[]
  payments         Payment[]
  ownerRequests    OwnerRequest[]
  wishlists        Wishlist[]
  notifications    Notification[]
  supportTickets   SupportTicket[]
  payouts          Payout[]
  reviews          Review[]
  messagesSent     Message[]     @relation("MessageSender")
  messagesReceived Message[]     @relation("MessageReceiver")
  conversations    Conversation[] @relation("ConversationParticipant")

  @@index([email])
  @@index([role])
  @@index([isActive])
}

// =============================================================
// ██████╗ ██████╗  ██████╗ ██████╗ ███████╗██████╗ ████████╗██╗   ██╗
// ██╔══██╗██╔══██╗██╔═══██╗██╔══██╗██╔════╝██╔══██╗╚══██╔══╝╚██╗ ██╔╝
// ██████╔╝██████╔╝██║   ██║██████╔╝█████╗  ██████╔╝   ██║    ╚████╔╝
// ██╔═══╝ ██╔══██╗██║   ██║██╔═══╝ ██╔══╝  ██╔══██╗   ██║     ╚██╔╝
// ██║     ██║  ██║╚██████╔╝██║     ███████╗██║  ██║   ██║      ██║
// ╚═╝     ╚═╝  ╚═╝ ╚═════╝ ╚═╝     ╚══════╝╚═╝  ╚═╝   ╚═╝      ╚═╝
// =============================================================

model Property {
  id         String  @id @default(cuid())
  propertyId String  @unique @default(cuid()) // public-facing short ID
  slug       String? @unique                  // SEO slug for website

  // Basic info
  propertyName String
  about        String? // short marketing description
  description  String? @db.Text // long description (website rich text)

  // Location
  location  String
  state     String?
  country   String?
  latitude  String?
  longitude String?
  address   String? // full formatted address
  /// Catalog destination (Admin Locations). Preferred over free-text matching.
  locationId Int?
  catalogLocation Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  // Capacity
  guests    Int @default(1)
  bedrooms  Int @default(1)
  bathrooms Int @default(1)
  kitchens  Int @default(0)

  // Pricing (stored in smallest unit, e.g. cents, or just float)
  minRate           Int  @default(0)
  nightlyRate       Int  @default(0)
  weekendRate       Int  @default(0)
  weeklyRate        Int  @default(0)
  monthlyRate       Int  @default(0)
  discountPercent   Int?
  additionalCharges String? // JSON: [{ name, amount, type: "fixed"|"percent" }]

  // Rate period (seasonal pricing)
  ratePeriodStart DateTime?
  ratePeriodEnd   DateTime?

  // Type & features
  rentalType String? // Apartment | Condo | House | Studio | Duplex House | Townhome
  areaM2     Int?
  amenities  String? // JSON: ["Wi-Fi Internet", "Pool", "Air Conditioning", ...]
  suitability String? // JSON: { pets: bool, children: bool, smoking: bool, wheelchair: bool, elder: bool }

  // Media
  images   String? // JSON: [url, url, ...]
  videoUrl String?

  // Rules
  policyAndHouseRules String?
  policyDetails       String? @db.Text
  checkInTime         String? // "15:00"
  checkOutTime        String? // "11:00"
  minNights           Int     @default(1)
  maxNights           Int?

  // Status & flags
  status     String  @default("Active") // Active | Inactive | Pending
  isFeatured Boolean @default(false)
  isNew      Boolean @default(true)

  // iCal calendar sync (Airbnb, VRBO, etc.)
  icalUrls String? // JSON: { airbnb: url, vrbo: url, ... }
  customFields String? // JSON: { fieldName: value }

  // SEO Fields
  seoTitle        String?
  seoDescription  String?
  seoKeywords     String? // Comma-separated or JSON array
  seoCanonicalUrl String? // Override canonical URL
  seoBacklinks    String? @db.Text // Admin internal notes for backlinks

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Owner
  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  // Child relations
  inquiries    Inquiry[]
  guestRequests GuestRequest[]
  bookings     Booking[]
  icalEvents   IcalEvent[]
  reviews      Review[]
  wishlists    Wishlist[]
  availability PropertyAvailability[]
  conversations Conversation[]

  @@index([ownerId])
  @@index([status])
  @@index([rentalType])
  @@index([location])
  @@index([locationId])
  @@index([isFeatured])
  @@index([slug])
}

// Owner-defined custom availability blocks (beyond bookings)
// e.g. maintenance, personal use, blocked ranges
model PropertyAvailability {
  id          String   @id @default(cuid())
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  date        DateTime @db.Date
  isAvailable Boolean  @default(false) // false = blocked
  note        String?  // reason e.g. "Maintenance"
  createdAt   DateTime @default(now())

  @@unique([propertyId, date])
  @@index([propertyId])
}

