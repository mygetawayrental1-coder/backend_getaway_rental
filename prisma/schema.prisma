// Subscription payments (PayPal)
// Booking payments are in BookingPayment model
// =============================================================

model Payment {
  id              String  @id @default(cuid())
  paypalOrderId   String  @unique
  paypalPaymentId String?
  amount          Float
  currency        String  @default("USD")
  status          String  @default("created") // created | paid | failed | refunded
  type            String  // subscription | booking

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId         String
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  subscriptionId String?           @unique
  subscription   UserSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
}

// =============================================================
// ███████╗ █████╗ ██████╗ ███╗   ██╗██╗███╗   ██╗ ██████╗ ███████╗
// ██╔════╝██╔══██╗██╔══██╗████╗  ██║██║████╗  ██║██╔════╝ ██╔════╝
// █████╗  ███████║██████╔╝██╔██╗ ██║██║██╔██╗ ██║██║  ███╗███████╗
