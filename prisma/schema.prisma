// ██║██╔════╝██╔══██╗██║
// ██║██║     ███████║██║
// ██║██║     ██╔══██║██║
// ██║╚██████╗██║  ██║███████╗
// ╚═╝ ╚═════╝╚═╝  ╚═╝╚══════╝
// iCal calendar sync (Airbnb, VRBO, etc.)
// =============================================================

model IcalEvent {
  id         String   @id @default(cuid())
  uid        String   @unique
  inquiryId  String?
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  dtStart    DateTime
  dtEnd      DateTime
  summary    String?
  icsContent String?
  source     String   @default("mygetawayrental") // mygetawayrental | airbnb | vrbo | other

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([propertyId])
  @@index([uid])
  @@index([dtStart, dtEnd])
}

model DynamicField {
  id          String   @id @default(cuid())
  name        String   @unique // machine name e.g. "parking_fee"
  label       String   // e.g. "Parking Fee"
  type        String   // "text" | "number" | "boolean" | "select" | "textarea"
  options     String?  // JSON string array for select: '["Included", "Paid"]'
  required    Boolean  @default(false)
  placeholder String?
  section     String   @default("details") // e.g. "capacity" | "amenities" | "rules" | "details"
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
