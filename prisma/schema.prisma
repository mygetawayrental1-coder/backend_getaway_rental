// ██║╚██╔╝██║██╔══╝  ╚════██║╚════██║██╔══██║██║   ██║██╔══╝  ╚════██║
// ██║ ╚═╝ ██║███████╗███████║███████║██║  ██║╚██████╔╝███████╗███████║
// ╚═╝     ╚═╝╚══════╝╚══════╝╚══════╝╚═╝  ╚═╝ ╚═════╝ ╚══════╝╚══════╝
// Host ↔ Guest in-app messaging
// Linked to a property and optional booking
// =============================================================

model Conversation {
  id         String   @id @default(cuid())
  propertyId String?
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  bookingId  String?   // link to a specific booking if applicable

  // Participants (two users — owner + guest)
  // For unauthenticated guests: guestEmail is used
  ownerId    String    // always an OWNER User.id
  guestId    String?   // User.id if guest is registered
  guestEmail String?   // if guest is not registered

  participants User[] @relation("ConversationParticipant")

  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  messages Message[]

  @@index([propertyId])
  @@index([ownerId])
  @@index([guestId])
  @@index([lastMessageAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  senderId   String?
  sender     User?   @relation("MessageSender", fields: [senderId], references: [id], onDelete: SetNull)
  receiverId String?
  receiver   User?   @relation("MessageReceiver", fields: [receiverId], references: [id], onDelete: SetNull)

  // For unauthenticated guests
  senderName  String?
  senderEmail String?

  content    String  @db.Text
  attachment String? // JSON: { url, type, name } — image/file attachment
  isRead     Boolean @default(false)
  readAt     DateTime?

  createdAt DateTime @default(now())

  @@index([conversationId])
  @@index([receiverId, isRead])
  @@index([createdAt])
}

// =============================================================
// ███████╗██╗   ██╗██████╗ ██████╗  ██████╗ ██████╗ ████████╗
// ██╔════╝██║   ██║██╔══██╗██╔══██╗██╔═══██╗██╔══██╗╚══██╔══╝
// ███████╗██║   ██║██████╔╝██████╔╝██║   ██║██████╔╝   ██║
// ╚════██║██║   ██║██╔═══╝ ██╔═══╝ ██║   ██║██╔══██╗   ██║
// ███████║╚██████╔╝██║     ██║     ╚██████╔╝██║  ██║   ██║
// ╚══════╝ ╚═════╝ ╚═╝     ╚═╝      ╚═════╝ ╚═╝  ╚═╝   ╚═╝
// Owner raises tickets → Admin resolves them
// =============================================================

model SupportTicket {
  id       String @id @default(cuid())
  ticketId String @unique @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  subject     String
  category    String  // booking | payout | property | account | other
  description String  @db.Text

  status   String @default("OPEN")   // OPEN | IN_PROGRESS | RESOLVED | CLOSED
  priority String @default("MEDIUM") // LOW | MEDIUM | HIGH | URGENT

  adminNotes  String?
  resolvedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  replies TicketReply[]

  @@index([userId])
  @@index([status])
  @@index([priority])
}

model TicketReply {
  id       String        @id @default(cuid())
  ticketId String
  ticket   SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  authorId String  // User.id (admin or owner)
  content  String  @db.Text
  isAdmin  Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([ticketId])
}

