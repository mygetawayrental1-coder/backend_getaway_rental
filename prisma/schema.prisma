// Website-only models
// =============================================================

// General website contact form (not a property inquiry)
model WebContactMessage {
  id      String @id @default(cuid())
  name    String
  email   String
  phone   String?
  subject String
  message String @db.Text

  isRead   Boolean  @default(false)
  readAt   DateTime?

  createdAt DateTime @default(now())

  @@index([isRead])
  @@index([email])
}

// Blog posts — created/managed by admin via admin portal
model BlogPost {
  id           String   @id @default(cuid())
  slug         String   @unique
  title        String
  excerpt      String
  content      String   @db.Text
  category     String
  thumbnailUrl String
  authorName   String
  readTimeMin  Int?     // estimated read time in minutes
  tags         String?  // JSON: ["travel", "US", ...]
  isPublished  Boolean  @default(false)
  publishedAt  DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isPublished])
  @@index([category])
  @@index([slug])
}

// Location / destination entries for homepage & search
// Hierarchy: COUNTRY → STATE → CITY (Property.locationId should point at CITY)
enum LocationType {
  COUNTRY
  STATE
  CITY
}

model Location {
  id          Int          @id @default(autoincrement())
  name        String
  slug        String       @unique
  type        LocationType @default(CITY)
  parentId    Int?
  parent      Location?    @relation("LocationTree", fields: [parentId], references: [id], onDelete: SetNull)
  children    Location[]   @relation("LocationTree")
  parentSlug  String? // legacy soft parent; kept for migration / SEO compat
  image       String
  description String?
  lat         Float?
  lng         Float?
  sortOrder   Int          @default(0)
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  properties Property[]

  @@index([parentSlug])
  @@index([parentId])
  @@index([type])
  @@index([isActive])
}

// Saved/favourite properties (website wishlist & mobile favourites)
model Wishlist {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, propertyId])
  @@index([userId])
}

// Website newsletter subscribers
model NewsletterSubscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  isActive       Boolean   @default(true)
  unsubscribedAt DateTime?
  createdAt      DateTime  @default(now())

  @@index([isActive])
}

