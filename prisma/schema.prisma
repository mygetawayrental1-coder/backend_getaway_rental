// ██████╔╝█████╗  ██║   ██║██║   ██║█████╗  ███████╗   ██║   ███████╗
// ██╔══██╗██╔══╝  ██║▄▄ ██║██║   ██║██╔══╝  ╚════██║   ██║   ╚════██║
// ██║  ██║███████╗╚██████╔╝╚██████╔╝███████╗███████║   ██║   ███████║
// ╚═╝  ╚═╝╚══════╝ ╚══▀▀═╝  ╚═════╝ ╚══════╝╚══════╝   ╚═╝   ╚══════╝
// Owner custom pricing / capacity requests → Admin reviews
// =============================================================

model OwnerRequest {
  id             String @id @default(cuid())
  userId         String
  user           User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type           String @default("CUSTOM_PRICING") // CUSTOM_PRICING | OTHER
  requestedPrice Float
  numProperties  Int
  message        String?
  phone          String?
  adminReply     String?

  status String @default("PENDING") // PENDING | REVIEWED | APPROVED | REJECTED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

