// Real-time push notifications for all roles across all apps
// =============================================================

model Notification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type  String // booking_pending | booking_confirmed | booking_cancelled |
               // booking_ongoing | booking_completed | review_new |
               // payout_processed | inquiry_new | subscription_expiring
  title String
  body  String
  data  String? // JSON: { bookingId, propertyId, reviewId, ... }

  isRead  Boolean   @default(false)
  readAt  DateTime?

  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@index([userId])
  @@index([createdAt])
}

